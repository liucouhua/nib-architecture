<mxfile host="app.diagrams.net" version="22.1.0" type="device">
<diagram id="module-map" name="Module map">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="2180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#172033;fontFamily=Helvetica;" value="Nowcast-in-a-Box  ·  Module map" vertex="1">
          <mxGeometry height="36" width="900" x="40" y="16" as="geometry" />
        </mxCell>
        <mxCell id="t2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#566275;fontFamily=Helvetica;" value="INTERFACE = write the contract. IMPLEMENTATION = one dataset or one model that implements it. SEVIR is an example dataset, not the data layer. Fill owner." vertex="1">
          <mxGeometry height="22" width="1700" x="42" y="52" as="geometry" />
        </mxCell>
        <mxCell id="laneA" parent="1" style="swimlane;html=1;startSize=36;rounded=1;arcSize=8;fontSize=14;fontStyle=1;align=left;spacingLeft=14;fontFamily=Helvetica;container=1;pointerEvents=0;fillColor=#F4F8FE;swimlaneFillColor=#EDF4FF;strokeColor=#7AA8D8;fontColor=#1F3E69;" value="A  Contracts — the shared interface everyone else imports" vertex="1">
          <mxGeometry height="300" width="1860" x="30" y="86" as="geometry" />
        </mxCell>
        <mxCell id="A1" parent="laneA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#F4F8FE;strokeColor=#3D74B5;strokeWidth=1.2;" value="&lt;b&gt;A1  Task profiles&lt;/b&gt;&lt;br&gt;INTERFACE · design&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• Write precip-nowcast.v1: variable, layout, UTC, missing.&lt;br&gt;• Versioning rule if a second profile is ever needed.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;A data package can offer v1 without this owner decoding files.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; file formats, model norm&lt;br&gt;owner: ________" vertex="1">
          <mxGeometry height="230" width="580" x="24" y="52" as="geometry" />
        </mxCell>
        <mxCell id="A2" parent="laneA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#F4F8FE;strokeColor=#3D74B5;strokeWidth=1.2;" value="&lt;b&gt;A2  Matcher&lt;/b&gt;&lt;br&gt;INTERFACE · design&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• offers ∩ requires, then shape / cadence / frames.&lt;br&gt;• Hard error vs warning; text the UI can show.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;Incompatible pairs never reach the runner.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; loading data, running models&lt;br&gt;owner: ________" vertex="1">
          <mxGeometry height="230" width="580" x="624" y="52" as="geometry" />
        </mxCell>
        <mxCell id="A3" parent="laneA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#F4F8FE;strokeColor=#3D74B5;strokeWidth=1.2;" value="&lt;b&gt;A3  Shared contracts&lt;/b&gt;&lt;br&gt;INTERFACE · exists&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• Types, Protocols, manifest parse. No IO.&lt;br&gt;• TaskSample / FieldSpec live here.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;Implementations depend only on this package plus their own files.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; FastAPI, Docker, normalisation&lt;br&gt;owner: ________" vertex="1">
          <mxGeometry height="230" width="580" x="1224" y="52" as="geometry" />
        </mxCell>
        <mxCell id="laneB" parent="1" style="swimlane;html=1;startSize=36;rounded=1;arcSize=8;fontSize=14;fontStyle=1;align=left;spacingLeft=14;fontFamily=Helvetica;container=1;pointerEvents=0;fillColor=#EEF7F5;swimlaneFillColor=#EFF9F6;strokeColor=#5A9D94;fontColor=#1E514B;" value="B  Data — one interface, many implementations" vertex="1">
          <mxGeometry height="560" width="1860" x="30" y="402" as="geometry" />
        </mxCell>
        <mxCell id="B1" parent="laneB" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#F4F8FE;strokeColor=#3D74B5;strokeWidth=1.2;" value="&lt;b&gt;B1  Data adapter interface&lt;/b&gt;&lt;br&gt;INTERFACE · design&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• Protocol: list_samples, load_sample, offers, close.&lt;br&gt;• Manifest schema for offers and fields.&lt;br&gt;• Tests a fake implementation must pass.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;New dataset = new datas/PACKAGE_ID/. This code does not change.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; HDF5 / ODIM / satellite / lightning decode&lt;br&gt;owner: ________" vertex="1">
          <mxGeometry height="230" width="900" x="24" y="52" as="geometry" />
        </mxCell>
        <mxCell id="B3" parent="laneB" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8F9CA9;strokeWidth=1.2;" value="&lt;b&gt;B3  Data catalog mount&lt;/b&gt;&lt;br&gt;PLATFORM · exists&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• NIB_DATA_ROOT layout, read-only.&lt;br&gt;• Fail with the missing path before a run.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;Several implementations coexist on one mount.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; decoding&lt;br&gt;owner: ________" vertex="1">
          <mxGeometry height="230" width="900" x="940" y="52" as="geometry" />
        </mxCell>
        <mxCell id="implB" parent="laneB" style="swimlane;html=1;startSize=36;rounded=1;arcSize=8;fontSize=14;fontStyle=1;align=left;spacingLeft=14;fontFamily=Helvetica;container=1;pointerEvents=0;startSize=28;fillColor=#FFFFFF;swimlaneFillColor=#F7FBFA;strokeColor=#7BB8AE;fontColor=#1E514B;fontSize=12;" value="Data implementations — same job, one package per dataset. SEVIR is the example already in prototype." vertex="1">
          <mxGeometry height="240" width="1812" x="24" y="300" as="geometry" />
        </mxCell>
        <mxCell id="B2" parent="implB" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#4D9A8E;strokeWidth=1.2;" value="&lt;b&gt;B2  SEVIR VIL (example)&lt;/b&gt;&lt;br&gt;IMPLEMENTATION · exists&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• datas/SEVIR implements B1.&lt;br&gt;• Offer precip-nowcast.v1 from HDF5.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;Matcher accepts SEVIR with current models.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; other datasets, the Protocol&lt;br&gt;owner: ________" vertex="1">
          <mxGeometry height="184" width="432" x="16" y="40" as="geometry" />
        </mxCell>
        <mxCell id="B4" parent="implB" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#4D9A8E;strokeWidth=1.2;dashed=1;dashPattern=6 4;" value="&lt;b&gt;B4  Local radar&lt;/b&gt;&lt;br&gt;IMPLEMENTATION · planned&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• datas/PACKAGE_ID for ODIM / national composite.&lt;br&gt;• Same job as SEVIR.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;Pairs through Matcher. B1 not edited.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; new task profiles&lt;br&gt;owner: ________" vertex="1">
          <mxGeometry height="184" width="432" x="464" y="40" as="geometry" />
        </mxCell>
        <mxCell id="B5" parent="implB" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#4D9A8E;strokeWidth=1.2;dashed=1;dashPattern=6 4;" value="&lt;b&gt;B5  Satellite&lt;/b&gt;&lt;br&gt;IMPLEMENTATION · planned&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• datas/PACKAGE_ID implements B1.&lt;br&gt;• Sat-to-radar, if needed, stays in this package.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;Offers are honest.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; a platform translator layer&lt;br&gt;owner: ________" vertex="1">
          <mxGeometry height="184" width="432" x="912" y="40" as="geometry" />
        </mxCell>
        <mxCell id="B6" parent="implB" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#4D9A8E;strokeWidth=1.2;dashed=1;dashPattern=6 4;" value="&lt;b&gt;B6  Lightning&lt;/b&gt;&lt;br&gt;IMPLEMENTATION · planned&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• datas/PACKAGE_ID implements B1.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;Loads and declares offers.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; a lightning task profile&lt;br&gt;owner: ________" vertex="1">
          <mxGeometry height="184" width="432" x="1360" y="40" as="geometry" />
        </mxCell>
        <mxCell id="laneC" parent="1" style="swimlane;html=1;startSize=36;rounded=1;arcSize=8;fontSize=14;fontStyle=1;align=left;spacingLeft=14;fontFamily=Helvetica;container=1;pointerEvents=0;fillColor=#F2F6FC;swimlaneFillColor=#EAF2FF;strokeColor=#7293C4;fontColor=#1F3E69;" value="C  Models — one interface, many implementations" vertex="1">
          <mxGeometry height="500" width="1860" x="30" y="978" as="geometry" />
        </mxCell>
        <mxCell id="C1" parent="laneC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#F4F8FE;strokeColor=#3D74B5;strokeWidth=1.2;" value="&lt;b&gt;C1  Model adapter interface&lt;/b&gt;&lt;br&gt;INTERFACE · exists&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• Protocol: predict(TaskSample).&lt;br&gt;• Manifest: requires, input, output, context_frames.&lt;br&gt;• Tests a fake model must pass.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;New model = new models/PACKAGE_ID/. This code does not change.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; a specific network's normalisation, file I/O&lt;br&gt;owner: ________" vertex="1">
          <mxGeometry height="200" width="1812" x="24" y="52" as="geometry" />
        </mxCell>
        <mxCell id="implC" parent="laneC" style="swimlane;html=1;startSize=36;rounded=1;arcSize=8;fontSize=14;fontStyle=1;align=left;spacingLeft=14;fontFamily=Helvetica;container=1;pointerEvents=0;startSize=28;fillColor=#FFFFFF;swimlaneFillColor=#F7FAFF;strokeColor=#8AA7D0;fontColor=#1F3E69;fontSize=12;" value="Model implementations — same job, one package per model" vertex="1">
          <mxGeometry height="212" width="1812" x="24" y="268" as="geometry" />
        </mxCell>
        <mxCell id="C2" parent="implC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#4B79B7;strokeWidth=1.2;" value="&lt;b&gt;C2  WADEPre&lt;/b&gt;&lt;br&gt;IMPLEMENTATION · exists&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• Adapter + ONNX.&lt;br&gt;• Owns 6-to-5 latest frames and training-time norm.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;predict() matches contract; bad samples rejected.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; other models, the Protocol&lt;br&gt;owner: ________" vertex="1">
          <mxGeometry height="156" width="432" x="16" y="40" as="geometry" />
        </mxCell>
        <mxCell id="C3" parent="implC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#4B79B7;strokeWidth=1.2;" value="&lt;b&gt;C3  NowcastNet&lt;/b&gt;&lt;br&gt;IMPLEMENTATION · exists&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• Adapter + artifact implementing C1.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;predict() matches contract; bad samples rejected.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; other models, the Protocol&lt;br&gt;owner: ________" vertex="1">
          <mxGeometry height="156" width="432" x="464" y="40" as="geometry" />
        </mxCell>
        <mxCell id="C4" parent="implC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#4B79B7;strokeWidth=1.2;" value="&lt;b&gt;C4  SimVP&lt;/b&gt;&lt;br&gt;IMPLEMENTATION · exists&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• Adapter + artifact implementing C1.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;predict() matches contract; bad samples rejected.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; other models, the Protocol&lt;br&gt;owner: ________" vertex="1">
          <mxGeometry height="156" width="432" x="912" y="40" as="geometry" />
        </mxCell>
        <mxCell id="C5" parent="implC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#4B79B7;strokeWidth=1.2;" value="&lt;b&gt;C5  exPreCast&lt;/b&gt;&lt;br&gt;IMPLEMENTATION · exists&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• Adapter + artifact implementing C1.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;predict() matches contract; bad samples rejected.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; other models, the Protocol&lt;br&gt;owner: ________" vertex="1">
          <mxGeometry height="156" width="432" x="1360" y="40" as="geometry" />
        </mxCell>
        <mxCell id="laneD" parent="1" style="swimlane;html=1;startSize=36;rounded=1;arcSize=8;fontSize=14;fontStyle=1;align=left;spacingLeft=14;fontFamily=Helvetica;container=1;pointerEvents=0;fillColor=#FFF8EE;swimlaneFillColor=#FFF8E9;strokeColor=#C49143;fontColor=#684512;" value="D  After inference — platform" vertex="1">
          <mxGeometry height="300" width="1860" x="30" y="1494" as="geometry" />
        </mxCell>
        <mxCell id="D1" parent="laneD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#C49143;strokeWidth=1.2;" value="&lt;b&gt;D1  Evaluation&lt;/b&gt;&lt;br&gt;PLATFORM · exists&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• Metrics from saved arrays.&lt;br&gt;• Thresholds change without rerunning inference.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;Changing CSI does not start ONNX.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; blocking inference, mutating predictions&lt;br&gt;owner: ________" vertex="1">
          <mxGeometry height="230" width="580" x="24" y="52" as="geometry" />
        </mxCell>
        <mxCell id="D2" parent="laneD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#C49143;strokeWidth=1.2;" value="&lt;b&gt;D2  Visualization&lt;/b&gt;&lt;br&gt;PLATFORM · exists&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• Registry by variable / product.&lt;br&gt;• vil-frames is one renderer, not the viz layer.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;A new variable registers without editing SEVIR.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; data decoding&lt;br&gt;owner: ________" vertex="1">
          <mxGeometry height="230" width="580" x="624" y="52" as="geometry" />
        </mxCell>
        <mxCell id="D3" parent="laneD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#C49143;strokeWidth=1.2;" value="&lt;b&gt;D3  Artifacts&lt;/b&gt;&lt;br&gt;PLATFORM · exists&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• Standard result dir.&lt;br&gt;• Failed runs stay inspectable.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;A failed run still opens in the UI.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; writing back into packages&lt;br&gt;owner: ________" vertex="1">
          <mxGeometry height="230" width="580" x="1224" y="52" as="geometry" />
        </mxCell>
        <mxCell id="laneE" parent="1" style="swimlane;html=1;startSize=36;rounded=1;arcSize=8;fontSize=14;fontStyle=1;align=left;spacingLeft=14;fontFamily=Helvetica;container=1;pointerEvents=0;fillColor=#F7F8FA;swimlaneFillColor=#F6F8FA;strokeColor=#8F9CA9;fontColor=#263247;" value="E  Runtime — platform" vertex="1">
          <mxGeometry height="300" width="1860" x="30" y="1810" as="geometry" />
        </mxCell>
        <mxCell id="E1" parent="laneE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8F9CA9;strokeWidth=1.2;" value="&lt;b&gt;E1  Control service&lt;/b&gt;&lt;br&gt;PLATFORM · exists&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• Catalog scan, Matcher, one child run, SSE.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;UI never imports an adapter.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; inference itself&lt;br&gt;owner: ________" vertex="1">
          <mxGeometry height="234" width="356" x="20" y="48" as="geometry" />
        </mxCell>
        <mxCell id="E2" parent="laneE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8F9CA9;strokeWidth=1.2;" value="&lt;b&gt;E2  Runner&lt;/b&gt;&lt;br&gt;PLATFORM · exists&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• One process. Calls B1/C1 implementations.&lt;br&gt;• NIB_PROGRESS on stdout.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;Truncation/norm only inside a model adapter.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; interpreting sample_id&lt;br&gt;owner: ________" vertex="1">
          <mxGeometry height="234" width="356" x="388" y="48" as="geometry" />
        </mxCell>
        <mxCell id="E3" parent="laneE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8F9CA9;strokeWidth=1.2;" value="&lt;b&gt;E3  Workflow config&lt;/b&gt;&lt;br&gt;PLATFORM · exists&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• Strict YAML v2: data id, model ids, init time.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;Hand-written YAML starts a run.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; a scheduler&lt;br&gt;owner: ________" vertex="1">
          <mxGeometry height="234" width="356" x="756" y="48" as="geometry" />
        </mxCell>
        <mxCell id="E4" parent="laneE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8F9CA9;strokeWidth=1.2;" value="&lt;b&gt;E4  Web UI&lt;/b&gt;&lt;br&gt;PLATFORM · exists&lt;br&gt;&lt;br&gt;&lt;b&gt;Do&lt;/b&gt;&lt;br&gt;• Select, run, compare.&lt;br&gt;• Hide Matcher-rejected pairs.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;Browser never starts Docker.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not&lt;/b&gt; Docker lifecycle&lt;br&gt;owner: ________" vertex="1">
